# Local Postgres from generosity-data (Homebrew Postgres 17 + pgvector)
DATABASE_URL=postgresql:///nombot

# Optional. Without keys NomBot runs in POC fallback mode:
#   query parsing  -> rule-based parser
#   embeddings     -> local nomic-embed-text-v1.5 (must match how generosity-data embedded rows)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# LLM_MODEL=openai:gpt-4o-mini        # or anthropic:claude-haiku-4-5
# EMBED_PROVIDER=openai               # openai | local
