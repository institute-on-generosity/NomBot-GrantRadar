# Local Postgres from generosity-data (Homebrew Postgres 17 + pgvector)
DATABASE_URL=postgresql:///nombot

# Claude API. Without a key, NomBot falls back to a rule-based query parser.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5          # switch Claude models here (e.g. claude-sonnet-5-5, claude-haiku-4-5)

# Embeddings: local nomic-embed-text-v1.5 (no key needed)
