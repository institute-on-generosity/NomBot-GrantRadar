# Local Postgres from generosity-data (Homebrew Postgres 17 + pgvector)
DATABASE_URL=postgresql:///nombot

# Claude API. Without a key, NomBot falls back to a rule-based query parser.
ANTHROPIC_API_KEY=
# Only for a user-level key (sk-ant-usr-…) that is not tied to a workspace: the workspace ID (wrkspc_…)
ANTHROPIC_WORKSPACE_ID=
# LLM_MODEL=claude-opus-5-5          # switch Claude models here (e.g. claude-sonnet-5-5, claude-haiku-4-5)

# Embeddings: local nomic-embed-text-v1.5 (no key needed)

# Partner API (/api/v1/*, /mcp): public address for absolute links in API responses, e.g. the tunnel URL.
# Unset: taken from the request's forwarded host.
# PUBLIC_BASE_URL=https://nombot.example.org   # also the link on exported slides (inlined at build/dev start via next.config env)
