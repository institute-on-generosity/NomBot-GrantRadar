      "dot": "cyan",
      "title": "Query path",
      "items": [
        "Claude turns a question into filters (state, city, Appalachia, cause, budget, must-mention) + search text",
        "One Postgres query: SQL filters + pgvector similarity + keywords",
        "Claude scores the top 40 (0–100, with a reason); strong matches first",
        "Research Buddy answers follow-ups from the top 15 results' 990 text, citing every claim"
      ]
    },
