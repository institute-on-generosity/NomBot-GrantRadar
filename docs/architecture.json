  "cards": [
    {
      "dot": "cyan",
      "title": "Search path",
      "items": [
        "Opus 5.5 turns a question into filters + search text",
        "One query: SQL filters, 2,000 nearest on a half-precision HNSW index, keyword hits",
        "Sonnet 5.5 scores the top 40, 0–100 with a reason",
        "Analysis panel: AI overview, landscape, county need gaps, funders, from the 200 closest",
        "Research Buddy (Opus 5.5) answers from the top 15 results' 990 text, citing every claim"
      ]
    },
    {
      "dot": "violet",
      "title": "Research answers",
      "items": [
        "Regex screen, then the router (Sonnet 5.5, structured output) writes a spec",
        "Answer engine runs fixed SQL on the research layer first; never model-written SQL",
        "Follow-ups: chips reuse specs; typed ones take one Sonnet 5.5 call",
        "Buddy, /api/v1/answer and MCP call the same engine",
        "Findings: the insights miner writes verified patterns; the feed shows them"
      ]
    },
    {
      "dot": "rose",
      "title": "Hosting + access",
      "items": [
        "MacBook: launchd service on :4000, public URL via Tailscale Funnel",
        "SITE_PASSWORD on every page; /api/v1 and /mcp need a Bearer key instead",
        "Keys: sha256 in api_keys, per-key rate limit, daily usage; no Claude calls except answer?q=",
        "Nightly pg_dump at 2:30 AM, newest 3 kept"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data",
      "items": [
        "IRS: 1.8M orgs (BMF), SOI financials, 785,772 990 filings, 5.35M foundation grants",
        "Grant recipients linked by name rules, then Claude for the largest leftovers",
        "Census SAIPE county need (3,144 counties), ARC Appalachia, NCES + IPEDS",
        "Cause labels (climate, women and girls) by Claude, graded on fresh samples",
        "Research layer: grant_cube 948,897 rows, recipient and county rollups, cause_lookup"
      ]
    }
